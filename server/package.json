{
  "name": "netpet-server",
  "version": "0.1.0",
  "private": true,
  "description": "API e banco de dados do netpet (Node + Postgres)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "db:migrar": "node --env-file-if-exists=.env db/migrar.js",
    "db:exemplo": "node --env-file-if-exists=.env db/exemplo.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 test/"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.11",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
