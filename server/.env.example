# Copie para .env e ajuste.
DATABASE_URL=postgres://netpet:netpet@localhost:5432/netpet
PORT=3333
# Em produção, gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SEGREDO=troque-este-segredo-em-producao
WEBHOOK_SEGREDO=segredo-local-de-webhook
# simulado = Pix e cartão aprovados na hora (para testar). Depois: mercadopago, pagarme, stripe...
PAGAMENTOS=simulado
# 1 = envia notificação push pelo Expo
ENVIAR_PUSH=0
FUSO=America/Sao_Paulo
